# ChromaFlow project config. Edit source inputs; derived outputs are auto-resolved.
# See: chromaflow help config; docs/OFFLINE.md; docs/DOWNSTREAM.md.
PROJECT_DIR="/data/projects/MyChIP"
# OUTPUT_DIR="${PROJECT_DIR}"         # Default: ${PROJECT_DIR}/outputs
REFERENCE_DIR="${PROJECT_DIR}/inputs/reference"
# RAW_DATA_DIR="${PROJECT_DIR}/00_data"

# SPECIES_SHORT prefixes derived filenames; labels do not control ID parsing.
SPECIES_SHORT="Species"
SPECIES_NAME="Your_species"
GENOME_VERSION="your_reference_release"
GENOME_FASTA_SOURCE="${REFERENCE_DIR}/genome.fa.gz"
GENOME_GFF3_SOURCE="${REFERENCE_DIR}/genes.gff3.gz"
ORGANELLE_SOURCES=()
# Optional local organelles (offline) or NCBI accession numbers (online):
# ORGANELLE_SOURCES=("chloroplast:/data/reference/chloroplast.fa")
ANNOTATION_INFO=""          # Optional Phytozome annotation_info file with GO terms
MEME_DB=""                  # Optional local MEME-format motif database

# Derived files are registered in <OUTPUT_DIR>/.chromaflow/reference.manifest.
# Explicit overrides take priority over that manifest; use only intentionally.
# GENOME_COMBINED="/path/to/combined.fa"
# CHROM_SIZES="/path/to/combined.chrom.sizes"
# GENOME_GFF3="/path/to/genes.normalized.gff3"
# GENOME_GTF="/path/to/genes.gtf"
# READ_LENGTH and MACS_GSIZE are measured by samplesheet/reference when unset.
# User-supplied values of these variables override measurement.

# Samples: defaults to samples_<type>.txt under the project.
# SAMPLES_FILE="/path/to/samples_chipseq.txt"
# FASTQ_PAIR_PATTERN="_R{R}_001.fastq.gz"
# FASTQ_SINGLE_END=false

NFCORE_CHIPSEQ_VERSION="2.1.0"
NFCORE_ATACSEQ_VERSION="2.1.2"
NFCORE_PROFILE="singularity"
# For an offline project, enable these or pass --offline --bundle on the CLI:
# NFCORE_OFFLINE=true
# NFCORE_OFFLINE_BUNDLE="/opt/chromaflow/bundles/chipseq-2.1.0"
# Online Conda alternative: NFCORE_PROFILE=conda
# NFCORE_CONDA_MIRROR=none    # tuna|bfsu|nju|sjtu|none|custom URL
# NFCORE_CONDA_TIMEOUT="3 h"
# SKIP_SPP=true
MAX_CPUS=16
MAX_MEMORY="64.GB"
MAX_TIME="72.h"

# IDR computes 0.01, 0.05 and 0.1. Choose downstream sets with --peakset.
# IDR_THRESHOLD only affects the optional support summary, not --peakset idr.
IDR_THRESHOLD=0.01
PROMOTER_UP=1000
PROMOTER_DOWN=200
TARGET_DIST_KB=3
KEGG_ORGANISM=""            # Empty disables online KEGG enrichment
MAKE_PLOTS=true
FIMO_PVAL=1e-4
TARGET_FEATURES="Promoter,5' UTR,1st Exon"
# TARGET_MAX_TSS_DIST=2000   # Optional upstream-distance rescue in candidates
# MEME_SEARCHSIZE=0          # 0: use all sequence; positive value limits MEME
TRACK_FLANK=3000
# TRACK_MAX=150
# DEEPT_BIN_SIZE=10
# SIGNAL_PEAK_WIN=2000
# SIGNAL_TSS_WIN=3000
# GFF_NORMALIZE_ENGINE=builtin
# GFF_TYPE_MAP="/path/to/type_roles.json"

# Optional downstream branch default. An explicit --peakset overrides this.
DEFAULT_PEAKSET=idr
# Shared candidates/lookup motif filters. Empty disables an optional filter.
MOTIF_IDS=""
FIMO_QVAL=""
MOTIF_EVALUE_MAX=""
CENTRIMO_EVALUE_MAX=""
# Region-specific annotation track heights: auto or positive cm.
TRACK_GENE_HEIGHT=auto
TRACK_MOTIF_HEIGHT=auto
