#!/usr/bin/env bash
# ============================================================================
# chromaflow.config — 项目配置（每个数据集一份，由用户编辑）
# ============================================================================
# 这是「配置」，不是代码。代码在 $CHROMAFLOW_HOME，装一次到处用。
# 换一个数据集 = 复制一份本文件并改路径，代码目录完全不动。
#
# ★ 只声明「你手里本来就有的东西」：源基因组 / 源注释 / 注释表 / motif 库。
#   由 chromaflow 生成的文件（combined.fa、chrom.sizes、.gtf、*.agat.gff3）
#   一律不写在这里 —— 生成它们的步骤会登记到
#     <OUTPUT_DIR>/.chromaflow/reference.manifest
#   后续步骤自动识别（也会扫描 REFERENCE_DIR）。需要覆盖时再显式赋值即可。
#
#   完整说明: chromaflow help config
# ============================================================================

# ─────────────── [I/O 锚点] ───────────────
PROJECT_DIR="/data/projects/CrDof_ChIP"          # ← 本数据集工作目录
# OUTPUT_DIR="${PROJECT_DIR}"                    # 结果/日志所在层（跑旧数据时指向旧 results 的父目录）
# INPUT_DIR="${PROJECT_DIR}/inputs"
# RAW_DATA_DIR="${INPUT_DIR}/raw"
REFERENCE_DIR="${PROJECT_DIR}/inputs/reference"  # 参考文件放这里；派生产物也默认落这里

# ─────────────── [物种] ───────────────
SPECIES_NAME="Chlamydomonas_reinhardtii"
SPECIES_SHORT="Cre"
GENOME_VERSION="v6.1"
# ─────────────── [自动实测的量，通常不用填] ───────────────
# MACS_GSIZE  有效基因组大小：chromaflow reference 用 khmer unique-kmers 实测，
#             写入 <OUTPUT_DIR>/.chromaflow/derived.env；测不到时 02 会改传
#             --read_length 让 nf-core 自己算。两条路都无需你手填。
# READ_LENGTH 读长：chromaflow samplesheet 从 fastq 抽样实测。
# 只有想覆盖实测结果时才取消注释（一旦写在这里，脚本就不再实测，以你的为准）：
# MACS_GSIZE=100000000
# READ_LENGTH=150
# 注：原 GC_CONTENT 已移除——它在流程中没有任何实际作用，04 的背景模型是由
#     fasta-get-markov 从基因组序列直接估计的。

# 细胞器基因组（完全可选）
#   格式: "名称:NCBI登录号"  或  "名称:本地文件路径"
#   该物种没有合适的叶绿体/线粒体基因组时，留空数组即可（下面这样），
#   或运行 chromaflow reference --skip-organelle；不影响任何下游分析。
ORGANELLE_SOURCES=(
    "chloroplast:NC_005353.1"
    "mitochondria:NC_001638.1"
)
# ORGANELLE_SOURCES=()        # ← 无细胞器时用这行
# SKIP_ORGANELLE=true         # ← 或者永久跳过细胞器合并

# ─────────────── [参考源文件] ───────────────
# 只写「源文件」。压缩与否都可以：ChromaFlow 按文件头魔数识别
# （gzip/bgzip、bzip2、xz、zstd、zip 自动解压；已解压的原地使用，不做多余拷贝）。
GENOME_FASTA_SOURCE="${REFERENCE_DIR}/assembly/CreinhardtiiCC_4532_707_v6.0.fa.gz"
GENOME_GFF3_SOURCE="${REFERENCE_DIR}/annotation/CreinhardtiiCC_4532_707_v6.1.gene.gff3.gz"

# 可选参考资源（留空则相关功能自动跳过；也会在 REFERENCE_DIR 里自动扫描）
ANNOTATION_INFO=""            # Phytozome annotation_info.txt（含 GO），05 的 GO 导出用
MEME_DB=""                    # motif 库，04 Tomtom 比对用，如 JASPAR2024_CORE_plants.meme

# ─────────────── [派生文件：一般不用填] ───────────────
# 下面这些由 chromaflow reference / normalize-gff 生成并自动识别。
# 只有在文件放在别处、或想强制指定某一份时才取消注释。
# GENOME_COMBINED="/path/to/Cre_combined.fa"
# CHROM_SIZES="/path/to/Cre_combined.chrom.sizes"
# GENOME_GTF="/path/to/Cre_genes.gtf"
# GENOME_GFF3="/path/to/Cre_genes.agat.gff3"

# ─────────────── [01 样本表 / FASTQ 配对] ───────────────
# SAMPLES_FILE=""             # 留空=自动找 samples_<type>.txt / samples.txt
# FASTQ_PAIR_PATTERN=""       # 留空=自动识别 R1/R2；命名很怪时写模板，如 "_good_{R}.fq.gz"
# FASTQ_SINGLE_END=false      # true=全部按单端处理

# ─────────────── [nf-core] ───────────────
NFCORE_CHIPSEQ_VERSION="2.1.0"
NFCORE_ATACSEQ_VERSION="2.1.2"
# 执行模式：既是 nextflow 的 -profile，也决定 `chromaflow run` 走哪条路径
#   singularity (默认) / apptainer / docker / podman → 容器模式，自动拉镜像
#   conda / mamba                                    → conda 模式，为每个
#       process 自建环境（首次约 30–60 分钟；适合拉不动镜像的受限网络）
#   也可组合，如 "singularity,test"；命令行 --profile 优先级更高
NFCORE_PROFILE="singularity"
# NFCORE_CONDA_MIRROR="none"   # conda 模式默认改用清华镜像；none = 用你自己的 channel
MAX_CPUS=64
MAX_MEMORY="300.GB"
MAX_TIME="72.h"

# ─────────────── [03 IDR] ───────────────
IDR_THRESHOLD=0.01

# ─────────────── [05 注释] ───────────────
# 启动子窗口 = ChIPseeker annotatePeak 的 tssRegion=c(-UP, +DOWN)。
# 由于优先级 Promoter>5UTR>Exon>Intron，含下游时 Promoter 会吸收 5'UTR 前端。
PROMOTER_UP=1000
PROMOTER_DOWN=200
TARGET_DIST_KB=3              # 距离过滤靶基因阈值 (kb)
KEGG_ORGANISM="cre"           # KEGG 物种码（衣藻=cre；留空跳过 KEGG）
MAKE_PLOTS=true               # Python 备选 05 是否出图

# ─────────────── [06 候选整合] ───────────────
FIMO_PVAL=1e-4                # FIMO motif 命中 p 值阈值（匹配质量）
# 合适位置特征集（逗号分隔）。可选:
#   Promoter / 5' UTR / 3' UTR / 1st Exon / Other Exon / 1st Intron / Other Intron / Downstream / Distal Intergenic
TARGET_FEATURES="Promoter"
# 例: TARGET_FEATURES="Promoter,1st Intron,1st Exon,Distal Intergenic"
TRACK_AUTO_TOPN=15            # candidates 自动画波峰图的高置信基因数(按强度)
# MEME_SEARCHSIZE=0           # MEME 搜索字符数上限(0=全部；序列多时可设 200000 限速)

# ─────────────── [07 单基因波峰图] ───────────────
TRACK_FLANK=3000              # 基因两侧延伸 (bp)
TRACK_GENES_TOPN=10           # 单独跑 tracks 且不给列表时取前 N 个靶基因
# TRACK_MAX=150               # bigWig 轨道统一 y 上限（空=自动）

# ─────────────── [(可选) 06 deepTools signal] ───────────────
# DEEPT_BIN_SIZE=10
# SIGNAL_PEAK_WIN=2000
# SIGNAL_TSS_WIN=3000

# ─────────────── [(可选) 00b GFF 规范化] ───────────────
# GFF_NORMALIZE_ENGINE=auto   # auto|agat|builtin|gffread（AGAT 装不上就用 builtin）
