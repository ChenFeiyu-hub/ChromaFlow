# One shared config for a DAP-seq batch; see docs/BATCH.md.
PROJECT_DIR="/data/projects/MyDAPbatch"
OUTPUT_DIR="${PROJECT_DIR}"
RAW_DATA_DIR="${PROJECT_DIR}/raw_data"
REFERENCE_DIR="${PROJECT_DIR}/reference"
SPECIES_SHORT="Species"
SPECIES_NAME="Your_species"
GENOME_VERSION="your_reference_release"
GENOME_FASTA_SOURCE="${REFERENCE_DIR}/genome.fa.gz"
GENOME_GFF3_SOURCE="${REFERENCE_DIR}/genes.gff3.gz"
ORGANELLE_SOURCES=()
ANNOTATION_INFO=""
MEME_DB=""

NFCORE_CHIPSEQ_VERSION="2.1.0"
NFCORE_PROFILE="singularity"
NFCORE_OFFLINE=true
NFCORE_OFFLINE_BUNDLE="/opt/chromaflow/bundles/chipseq-2.1.0"
MAX_CPUS=8
MAX_MEMORY="32.GB"
MAX_TIME="72.h"
SKIP_SPP=true

# The batch runner switches environments via conda run; no manual activation
# is required between steps. Names or absolute environment prefixes are valid.
BATCH_ENV_MODE=conda
# BATCH_CONDA_EXE="/path/to/miniforge3/bin/conda"
BATCH_ENV_REF="ChromaFlow_ref"
BATCH_ENV_RUN="ChromaFlow_runtime"
BATCH_ENV_ANNOTATE="ChromaFlow_R"
BATCH_ENV_MOTIF="ChromaFlow_motif"
BATCH_ENV_CANDIDATES="ChromaFlow_downstream"
BATCH_MEME_THREADS=8
# Only enable after reviewing the experiment/control design. SE treatment
# calls MACS3 in BAM mode; the paired control is still aligned as paired-end.
BATCH_ALLOW_SE_WITH_PE_CONTROL=false
# Default input identity is path + size + nanosecond mtime; true hashes whole
# FASTQs as well, at the cost of reading every compressed file on each plan/run.
BATCH_FASTQ_SHA256=false

# Do not set a global READ_LENGTH. Each analysis is measured separately;
# an optional read_length TSV column can supply reviewed per-run overrides.
# Leave MACS_GSIZE unset for estimation once per reference + k.
PROMOTER_UP=1000
PROMOTER_DOWN=200
TARGET_DIST_KB=3
MAKE_PLOTS=true
KEGG_ORGANISM=""
FIMO_PVAL=1e-4
TARGET_FEATURES="Promoter,5' UTR,1st Exon"
TARGET_MAX_TSS_DIST=0
MEME_SEARCHSIZE=0
MOTIF_IDS=""
FIMO_QVAL=""
MOTIF_EVALUE_MAX=""
CENTRIMO_EVALUE_MAX=""
DEFAULT_PEAKSET=consensus
